# ===== 基本設定 =====
export HISTFILE=~/.zsh_history
export HISTSIZE=50000
export SAVEHIST=50000
setopt SHARE_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_REDUCE_BLANKS

# ===== 補全（cd 提示的關鍵）=====
autoload -Uz compinit
compinit -C                    # -C 加快啟動速度
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path ~/.zsh/cache

# ===== 插件 =====
source ~/.zsh/fzf-tab/fzf-tab.plugin.zsh
source ~/.zsh/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# Autosuggestions 設定（灰色提示）
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=8'

# ===== 按鍵綁定 =====
# 上/下鍵做 history search，並自動把游標移到行尾
autoload -U history-search-end
zle -N history-beginning-search-backward-end history-search-end
zle -N history-beginning-search-forward-end history-search-end

# EDITOR=nvim 含有 vi，zsh 會選 viins；寫死避免以後 EDITOR 不含 vi 時跑掉
bindkey -v

# 上下鍵搜尋指令歷史紀錄
# 一般模式是 Esc [ A/B；應用游標模式是 Esc O A/B（字母 O）
bindkey -M viins '^[[A' history-beginning-search-backward-end
bindkey -M viins '^[[B' history-beginning-search-forward-end
bindkey -M viins '^[OA' history-beginning-search-backward-end
bindkey -M viins '^[OB' history-beginning-search-forward-end

# Home / End
bindkey -M viins '^[[H'  beginning-of-line
bindkey -M viins '^[[1~' beginning-of-line
bindkey -M viins '^[OH'  beginning-of-line
bindkey -M vicmd '^[[H'  vi-beginning-of-line
bindkey -M vicmd '^[[1~' vi-beginning-of-line
bindkey -M vicmd '^[OH'  vi-beginning-of-line
bindkey -M viins '^[[F'  end-of-line
bindkey -M viins '^[[4~' end-of-line
bindkey -M viins '^[OF'  end-of-line
bindkey -M vicmd '^[[F'  vi-end-of-line
bindkey -M vicmd '^[[4~' vi-end-of-line
bindkey -M vicmd '^[OF'  vi-end-of-line

# Ctrl / Alt + Left / Right，以 word 為單位移動
bindkey -M viins '^[[1;5D' backward-word
bindkey -M viins '^[[5D'   backward-word
bindkey -M viins '^[[1;3D' backward-word
bindkey -M viins '^[[1;5C' forward-word
bindkey -M viins '^[[5C'   forward-word
bindkey -M viins '^[[1;3C' forward-word
bindkey -M vicmd '^[[1;5D' vi-backward-word
bindkey -M vicmd '^[[5D'   vi-backward-word
bindkey -M vicmd '^[[1;3D' vi-backward-word
bindkey -M vicmd '^[[1;5C' vi-forward-word
bindkey -M vicmd '^[[5C'   vi-forward-word
bindkey -M vicmd '^[[1;3C' vi-forward-word

# Delete / Ctrl+Delete / Ctrl+Backspace / Alt+Backspace
bindkey -M viins '^[[3~' delete-char
bindkey -M vicmd '^[[3~' vi-delete-char
bindkey -M viins '^[[3;5~' kill-word
bindkey -M vicmd '^[[3;5~' kill-word
bindkey -M viins '^H' backward-kill-word
bindkey -M vicmd '^H' vi-backward-kill-word
bindkey -M viins '^[[127;5u' backward-kill-word
bindkey -M vicmd '^[[127;5u' vi-backward-kill-word
bindkey -M viins '^[^?' backward-kill-word
bindkey -M vicmd '^[^?' vi-backward-kill-word

bindkey -M viins '^[[Z' reverse-menu-complete

# ===== 常用 alias =====
alias ll='ls -lah --color=auto'
alias gs='git status'
alias gd='git diff'
alias gl='git log --oneline --graph -15'
